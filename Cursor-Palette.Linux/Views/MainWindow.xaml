<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svc="clr-namespace:CursorPalette.Services;assembly=Cursor-Palette.Core"
		x:Class="CursorPalette.Linux.Views.MainWindow"
		Width="860"
		Height="640"
		Background="{DynamicResource SystemRegionBrush}">
	<Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
		<!-- Toolbar -->
		<Border Grid.Row="0"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				Padding="12,8">
			<StackPanel Orientation="Horizontal"
						Spacing="8"
						VerticalAlignment="Center">
				<TextBlock Text="Cursor Palette"
						   FontSize="16"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
				<Separator Margin="8,0" />
				<TextBlock x:Name="DefaultLabel"
					   Text="Default"
						   VerticalAlignment="Center"
						   Margin="4,0" />
				<Slider x:Name="SizeSlider"
						Minimum="16"
						Maximum="128"
						Value="32"
						Width="160"
						VerticalAlignment="Center" />
				<TextBlock x:Name="SizeValueText"
						   Text="32 px"
						   VerticalAlignment="Center"
						   Margin="4,0" />
				<Button x:Name="ApplySizeButton"
						Content="Apply"
						VerticalAlignment="Center" />
				<Separator Margin="8,0" />
				<Button x:Name="UndoButton"
						Content="Undo"
						VerticalAlignment="Center"
						IsEnabled="{Binding CanUndo}"
						Click="OnUndoClick" />
				<Separator Margin="8,0" />
				<Button x:Name="ThemeToggleButton"
						Content="☀"
						VerticalAlignment="Center"
						Click="OnThemeToggle" />
				<Button x:Name="LanguageButton"
						Content="EN"
						VerticalAlignment="Center"
						Click="OnLanguageClick" />
				<Separator Margin="8,0" />
				<Button x:Name="ZoomOutButton"
						Content="−"
						VerticalAlignment="Center"
						Click="OnZoomOutClick" />
				<TextBlock x:Name="ZoomText"
						   Text="100%"
						   VerticalAlignment="Center"
						   Margin="4,0" />
				<Button x:Name="ZoomInButton"
						Content="+"
						VerticalAlignment="Center"
						Click="OnZoomInClick" />
				<Separator Margin="8,0" />
				<TextBlock x:Name="CellScaleLabel"
						   Text="Cells"
						   VerticalAlignment="Center"
						   Margin="4,0" />
				<Slider x:Name="CellScaleSlider"
						Minimum="0.5"
						Maximum="3.5"
						Value="1.0"
						Width="100"
						TickFrequency="0.1"
						IsSnapToTickEnabled="True"
						VerticalAlignment="Center" />
				<TextBlock x:Name="CellScaleValueText"
						   Text="100%"
						   VerticalAlignment="Center"
						   Margin="4,0" />
			</StackPanel>
		</Border>

		<!-- Gallery -->
		<ScrollViewer Grid.Row="1"
					  HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Disabled">
			<ItemsControl x:Name="Gallery"
						  ItemsSource="{Binding Board}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Width="148"
								Height="148"
								Margin="6"
								CornerRadius="10"
								BorderThickness="2"
								BorderBrush="{DynamicResource SystemControlDefaultChromeMediumBrush}"
								Background="{DynamicResource SystemRegionBrush}"
								Classes.active="{Binding IsActive}"
								Classes.group="{Binding IsGroup}"
								PointerPressed="OnPresetClick">
							<Border.ContextMenu>
								<ContextMenu Opening="OnContextMenuOpening">
									<MenuItem x:Name="MenuEditItem"
											  Header="Edit"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuEdit" />
									<MenuItem x:Name="MenuRenameItem"
											  Header="Rename"
											  IsVisible="{Binding !IsGroup}"
											  Click="OnMenuRename" />
									<MenuItem x:Name="MenuMoveLeftItem"
											  Header="Move left"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuMoveLeft" />
									<MenuItem x:Name="MenuMoveRightItem"
											  Header="Move right"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuMoveRight" />
									<MenuItem x:Name="MenuDownloadItem"
											  Header="Download"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuDownload" />
									<MenuItem x:Name="MenuToggleCollapseItem"
											  Header="Collapse/Expand"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuToggleCollapse" />
									<MenuItem x:Name="MenuDeleteItem"
											  Header="Delete"
											  Click="OnMenuDelete" />
								</ContextMenu>
							</Border.ContextMenu>
							<StackPanel VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Spacing="4">
								<!-- Add cell -->
								<TextBlock Text="+"
									   FontSize="34"
									   HorizontalAlignment="Center"
									   IsVisible="{Binding IsAddCell}" />
								<!-- Group cell -->
								<TextBlock Text="{Binding DisplayName}"
										   FontSize="14"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   MaxWidth="130"
										   IsVisible="{Binding IsGroup}" />
								<TextBlock Text="{Binding MembersCountText}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsGroup}" />
								<TextBlock Text="{Binding CollapsedText}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsCollapsed}" />
								<!-- Preset cell -->
								<Image Source="{Binding Preview}"
									   Width="48"
									   Height="48"
									   IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
								<TextBlock Text="{Binding DisplayName}"
										   FontSize="13"
										   HorizontalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   MaxWidth="130"
										   IsVisible="{Binding !IsGroup}" />
								<TextBlock Text="{Binding RoleCount}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsPreset}" />
								<TextBlock FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsPreset}"
										   Text="{Binding BaseSize, StringFormat='{}{0} px'}" />
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<TextBlock Grid.Row="1"
				   x:Name="EmptyGalleryHint"
				   Text="No presets yet. Drop cursor files (.cur/.ani) onto the window or click Add preset."
				   FontSize="14"
				   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   IsVisible="{Binding Board.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}"
				   IsHitTestVisible="False" />

		<!-- Footer -->
		<Border Grid.Row="2"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				Padding="12,6">
			<TextBlock Text="{Binding FooterText}"
					   FontSize="11"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   PointerPressed="OnFooterClick" />
		</Border>
	</Grid>
</Window>
