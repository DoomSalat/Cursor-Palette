<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svc="clr-namespace:CursorPalette.Services;assembly=Cursor-Palette.Core"
		x:Class="CursorPalette.Linux.Views.MainWindow"
		Width="860"
		Height="640"
		MinWidth="720"
		MinHeight="440"
		Background="{DynamicResource SystemRegionBrush}">
	<Grid x:Name="RootGrid">
	<LayoutTransformControl x:Name="UiScaleTransformControl">
	<Grid x:Name="ContentGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">
		<!-- Toolbar row 1: logo (left) + theme/language (right) -->
		<Border Grid.Row="0"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				Padding="12,8">
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
				<StackPanel Grid.Column="0"
							Orientation="Horizontal"
							VerticalAlignment="Center"
							Spacing="8"
							Cursor="Hand"
							ToolTip.Tip="Random cursor from the entire board"
							PointerPressed="OnAppLogoClick">
					<Path Width="18"
						  Height="18"
						  Stretch="Uniform"
						  Fill="{DynamicResource SystemAccentColor}"
						  Data="M 0,0 L 0,16 L 4.5,12 L 7,18 L 9,17 L 6.5,11 L 12,11 Z" />
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock x:Name="AppLogoText"
								   Text="Cursor"
								   FontSize="16"
								   FontWeight="SemiBold"
								   VerticalAlignment="Center" />
						<TextBlock Text="Palette"
								   FontSize="16"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource SystemAccentColor}"
								   VerticalAlignment="Center"
								   Margin="2,0,0,0" />
					</StackPanel>
				</StackPanel>

				<Button x:Name="ThemeToggleButton"
						Grid.Column="2"
						Content="☀"
						VerticalAlignment="Center"
						Margin="0,0,8,0"
						Click="OnThemeToggle" />
				<Button x:Name="LanguageButton"
						Grid.Column="3"
						Content="EN"
						VerticalAlignment="Center"
						Margin="0,0,8,0"
						Click="OnLanguageClick" />
				<Button x:Name="InfoButton"
						Grid.Column="4"
						Content="ⓘ"
						VerticalAlignment="Center"
						Click="OnInfoClick" />
			</Grid>
		</Border>

		<!-- Toolbar row 2: size slider (left) + cell scale (middle) + undo (right) -->
		<Border Grid.Row="1"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				Padding="12,8">
			<Grid ColumnDefinitions="Auto,Auto,*,Auto">
				<!-- Cursor size group -->
				<Border Grid.Column="1"
						BorderBrush="{DynamicResource SystemAccentColor}"
						BorderThickness="1.5"
						CornerRadius="8"
						Padding="10,5"
						Margin="0,0,12,0">
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Center"
								Spacing="8">
						<TextBlock x:Name="DefaultLabel"
								   Text="Default"
								   VerticalAlignment="Center"
								   Margin="0,0,4,0" />
						<Slider x:Name="SizeSlider"
								Minimum="16"
								Maximum="128"
								Value="32"
								MinWidth="80"
								TickFrequency="16"
								IsSnapToTickEnabled="True"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Center" />
						<TextBlock x:Name="SizeValueText"
								   Text="32 px"
								   VerticalAlignment="Center"
								   Margin="4,0" />
						<CheckBox x:Name="ScaleCursorsCheckBox"
								  Margin="8,0,0,0"
								  VerticalAlignment="Center"
								  ToolTip.Tip="{DynamicResource S.ScaleCursors.Tooltip}"
								  Click="OnScaleCursorsClick" />
						<Border x:Name="ScaleModeButton"
								Width="28" Height="28"
								CornerRadius="6"
								Background="{DynamicResource BrushSurfaceHover}"
								BorderBrush="{DynamicResource SystemControlBorderBrush}"
								BorderThickness="1"
								Margin="4,0,0,0"
								Cursor="Hand"
								PointerPressed="OnScaleModeIconClick"
								ToolTip.Tip="{DynamicResource S.ScaleCursors.Tooltip}">
							<Image x:Name="ScaleModeIcon"
								   Width="16"
								   Height="16"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />
						</Border>
						<Button x:Name="ApplySizeButton"
								Content="Apply"
								Margin="8,0,0,0"
								VerticalAlignment="Center" />
					</StackPanel>
				</Border>

				<!-- Cell scale group -->
				<Border Grid.Column="0"
						BorderBrush="{DynamicResource SystemAccentColor}"
						BorderThickness="1.5"
						CornerRadius="8"
						Padding="10,5"
						Margin="0,0,16,0">
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Center"
								Spacing="8">
						<TextBlock x:Name="CellScaleLabel"
								   Text="Cells"
								   VerticalAlignment="Center"
								   Margin="0,0,4,0" />
						<Slider x:Name="CellScaleSlider"
								Minimum="0.5"
								Maximum="3.5"
								Value="1.0"
								MinWidth="60"
								HorizontalAlignment="Stretch"
								TickFrequency="0.1"
								IsSnapToTickEnabled="True"
								VerticalAlignment="Center" />
						<TextBlock x:Name="CellScaleValueText"
								   Text="100%"
								   VerticalAlignment="Center"
								   Margin="4,0" />
					</StackPanel>
				</Border>

				<!-- Undo (right) -->
				<Button x:Name="UndoButton"
						Grid.Column="3"
						Content="Undo"
						VerticalAlignment="Center"
						IsEnabled="{Binding CanUndo}"
						Click="OnUndoClick" />
			</Grid>
		</Border>

		<!-- Gallery -->
		<ScrollViewer Grid.Row="2"
					  HorizontalScrollBarVisibility="Disabled"
					  VerticalScrollBarVisibility="Auto">
			<ScrollViewer.ContextMenu>
				<ContextMenu>
					<MenuItem x:Name="MenuCreateGroupItem"
							  Header="Create group"
							  Click="OnMenuCreateGroup" />
				</ContextMenu>
			</ScrollViewer.ContextMenu>
			<LayoutTransformControl x:Name="CellScaleTransformControl">
			<ItemsControl x:Name="Gallery"
						  ItemsSource="{Binding Board}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Width="148"
								Height="148"
								Margin="6"
								CornerRadius="10"
								BorderThickness="2"
								BorderBrush="{DynamicResource SystemControlBorderBrush}"
								Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
								Classes.active="{Binding IsActive}"
								Classes.group="{Binding IsGroup}"
								Classes.cell="True"
								Classes.selected="{Binding IsSelected}"
								PointerPressed="OnPresetClick"
								PointerMoved="OnPresetPointerMoved"
								PointerReleased="OnPresetPointerReleased">
							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
									<TextBlock Text="{Binding ContextHint}"
											   FontSize="11"
											   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
											   Margin="0,2,0,0" />
								</StackPanel>
							</ToolTip.Tip>
							<Border.ContextMenu>
								<ContextMenu Opening="OnContextMenuOpening">
									<MenuItem x:Name="MenuEditItem"
											  Header="Edit"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuEdit" />
									<MenuItem x:Name="MenuRenameItem"
											  Header="Rename"
											  IsVisible="{Binding !IsGroup}"
											  Click="OnMenuRename" />
									<MenuItem x:Name="MenuMoveLeftItem"
											  Header="Move left"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuMoveLeft" />
									<MenuItem x:Name="MenuMoveRightItem"
											  Header="Move right"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuMoveRight" />
									<MenuItem x:Name="MenuDownloadItem"
											  Header="Download"
											  IsVisible="{Binding IsPreset}">
										<MenuItem Header="Quick download"
												  Click="OnMenuDownloadRaw" />
										<MenuItem Header="Full export (Windows + Linux)"
												  Click="OnMenuDownloadFullExport" />
										<MenuItem Header="Linux archive (.zip)"
												  Click="OnMenuDownloadLinuxArchive" />
										<MenuItem Header="Xcursor theme (Linux)"
												  Click="OnMenuDownloadXcursorTheme" />
									</MenuItem>
									<MenuItem x:Name="MenuUseScalingItem"
											  Header="Use scaling"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuUseScaling" />
									<MenuItem x:Name="MenuScaleModeItem"
											  Header="Scale mode"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuScaleMode" />
									<MenuItem x:Name="MenuDownloadSystemItem"
											  Header="Download system cursors"
											  IsVisible="{Binding IsDefaultCell}">
										<MenuItem Header="As PNG + GIF"
												  Click="OnMenuDownloadSystemImages" />
										<MenuItem Header="As .cur and .ani"
												  Click="OnMenuDownloadSystemCurAni" />
										<MenuItem Header="As .xcursor"
												  Click="OnMenuDownloadSystemXcursor" />
									</MenuItem>
									<MenuItem x:Name="MenuRandomPresetItem"
											  Header="Random pick"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuRandomPreset" />
									<MenuItem x:Name="MenuEditGroupItem"
											  Header="Edit group"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuEditGroup" />
									<MenuItem x:Name="MenuConsolidateGroupItem"
											  Header="Group cells together"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuConsolidateGroup" />
									<MenuItem x:Name="MenuUngroupItem"
											  Header="Ungroup"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuUngroup" />
									<MenuItem x:Name="MenuToggleCollapseItem"
											  Header="Collapse/Expand"
											  IsVisible="{Binding IsGroup}"
											  Click="OnMenuToggleCollapse" />
									<MenuItem x:Name="MenuAssignToGroupItem"
											  Header="Add to group"
											  IsVisible="{Binding IsPreset}"
											  Click="OnMenuAssignToGroup" />
									<MenuItem x:Name="MenuRemoveFromGroupItem"
											  Header="Remove from group"
											  IsVisible="{Binding GroupId, Converter={x:Static ObjectConverters.IsNotNull}}"
											  Click="OnMenuRemoveFromGroup" />
									<Separator IsVisible="{Binding IsPreset}" />
									<Separator IsVisible="{Binding IsGroup}" />
									<MenuItem x:Name="MenuDeleteItem"
											  Header="Delete"
											  Click="OnMenuDelete" />
								</ContextMenu>
							</Border.ContextMenu>
						<Grid>
							<Border CornerRadius="8"
									IsHitTestVisible="False"
									IsVisible="{Binding IsGroup}"
									Background="{Binding GroupColorHex}" />
							<Border Width="4"
									HorizontalAlignment="Left"
									VerticalAlignment="Stretch"
									Margin="0,0,0,0"
									CornerRadius="2,0,0,2"
									IsHitTestVisible="False"
									IsVisible="{Binding GroupColorHex, Converter={x:Static ObjectConverters.IsNotNull}}"
									Background="{Binding GroupColorHex}" />
							<StackPanel VerticalAlignment="Center"
										HorizontalAlignment="Center"
										Spacing="4">
								<!-- Add cell -->
								<TextBlock Text="+"
									   FontSize="34"
									   HorizontalAlignment="Center"
									   IsVisible="{Binding IsAddCell}" />
								<!-- Group cell -->
								<TextBlock Text="{Binding DisplayName}"
										   FontSize="14"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   MaxWidth="130"
										   Foreground="White"
										   IsVisible="{Binding IsGroup}" />
								<TextBlock Text="{Binding MembersCountText}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="White"
										   IsVisible="{Binding IsGroup}" />
								<TextBlock Text="{Binding CollapsedText}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="White"
										   IsVisible="{Binding IsCollapsed}" />
								<!-- Preset cell -->
								<Image Source="{Binding Preview}"
									   Width="48"
									   Height="48"
									   IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}" />
								<TextBlock Text="{Binding DisplayName}"
										   FontSize="13"
										   HorizontalAlignment="Center"
										   TextTrimming="CharacterEllipsis"
										   MaxWidth="130"
										   IsVisible="{Binding !IsGroup}" />
								<TextBlock Text="{Binding RoleCount}"
										   FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsPreset}" />
								<TextBlock FontSize="11"
										   HorizontalAlignment="Center"
										   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
										   IsVisible="{Binding IsPreset}"
										   Text="{Binding BaseSize, StringFormat='{}{0} px'}" />
							</StackPanel>
							<TextBlock Text="🧩"
									   FontSize="15"
									   HorizontalAlignment="Right"
									   VerticalAlignment="Top"
									   Margin="0,4,6,0"
									   IsHitTestVisible="False"
									   IsVisible="{Binding IsMixed}" />
							<Image Width="13"
								   Height="13"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Bottom"
								   Margin="0,0,6,4"
								   IsHitTestVisible="False"
								   IsVisible="{Binding UseScaling}"
								   Source="avares://Cursor-Palette-Linux/Resources/StairIcon24.png" />
							<Border Width="6"
									Height="6"
									CornerRadius="3"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="4,4,0,0"
									IsHitTestVisible="False"
									IsVisible="{Binding GroupColorHex, Converter={x:Static ObjectConverters.IsNotNull}}"
									Background="{Binding GroupColorHex}" />
							<Border Width="18"
									Height="18"
									CornerRadius="9"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Margin="6,4,0,0"
									IsHitTestVisible="False"
									IsVisible="{Binding IsSelected}"
									Background="{DynamicResource SystemAccentColor}">
								<TextBlock Text="✓"
										   FontSize="11"
										   Foreground="White"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center" />
							</Border>
						</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			</LayoutTransformControl>
		</ScrollViewer>

		<TextBlock Grid.Row="2"
				   x:Name="EmptyGalleryHint"
				   Text="No presets yet. Drop cursor files (.cur/.ani) onto the window or click Add preset."
				   FontSize="14"
				   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center"
				   IsVisible="{Binding Board.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}"
				   IsHitTestVisible="False" />

	<!-- Group toolbar (visible when presets are Ctrl+click selected) -->
	<Border x:Name="GroupToolbar"
			Grid.Row="3"
			Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
			BorderBrush="{DynamicResource SystemControlDefaultChromeMediumBrush}"
			BorderThickness="0,1,0,0"
			Padding="12,6"
			IsVisible="False">
		<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
			<TextBlock x:Name="GroupSelectionCountText"
					   Grid.Column="0"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   VerticalAlignment="Center"
					   Margin="0,0,16,0" />
			<WrapPanel x:Name="GroupColorSwatches"
					   Grid.Column="1"
					   Orientation="Horizontal"
					   VerticalAlignment="Center"
					   Margin="0,0,16,0" />
			<TextBox x:Name="GroupNameBox"
					 Grid.Column="2"
					 VerticalAlignment="Center"
					 MaxWidth="200"
					 Margin="0,0,12,0" />
			<Button x:Name="GroupCancelButton"
					Grid.Column="3"
					Content="Cancel"
					Margin="0,0,8,0"
					MinWidth="80"
					Click="OnGroupCancelClick" />
			<Button x:Name="GroupCreateButton"
					Grid.Column="4"
					Content="Create group"
					MinWidth="100"
					Click="OnGroupCreateClick" />
		</Grid>
	</Border>

	<!-- Footer: zoom controls (left) + footer text (right) -->
		<Border Grid.Row="4"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				Padding="12,6">
			<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
				<StackPanel Grid.Column="0"
							Orientation="Horizontal"
							VerticalAlignment="Center"
							Spacing="4">
					<Button x:Name="ZoomOutButton"
							Content="−"
							VerticalAlignment="Center"
							Click="OnZoomOutClick" />
					<TextBlock x:Name="ZoomText"
							   Text="100%"
							   VerticalAlignment="Center"
							   Margin="4,0" />
					<Button x:Name="ZoomInButton"
							Content="+"
							VerticalAlignment="Center"
							Click="OnZoomInClick" />
				</StackPanel>

				<Button x:Name="ExportButton"
						Grid.Column="1"
						Content="📤"
						FontSize="14"
						Padding="8,4"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Click="OnExportClick" />

				<Button x:Name="ImportButton"
						Grid.Column="2"
						Content="📥"
						FontSize="14"
						Padding="8,4"
						Margin="4,0,0,0"
						VerticalAlignment="Center"
						Click="OnImportClick" />

				<Button x:Name="OpenFolderToggle"
						Grid.Column="3"
						Content="📂"
						FontSize="14"
						Padding="8,4"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Click="OnOpenFolderToggleClick" />

				<TextBlock Grid.Column="4"
						   Text="{Binding FooterText}"
						   FontSize="11"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   HorizontalAlignment="Right"
						   VerticalAlignment="Center"
						   TextTrimming="CharacterEllipsis"
						   PointerPressed="OnFooterClick" />

				<Ellipse x:Name="UpdateSpinner"
						Grid.Column="5"
						Width="12"
						Height="12"
						Stroke="CornflowerBlue"
						StrokeThickness="2"
						StrokeDashArray="14,5"
						RenderTransformOrigin="0.5,0.5"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						IsVisible="False">
					<Ellipse.RenderTransform>
						<RotateTransform Angle="0" />
					</Ellipse.RenderTransform>
				</Ellipse>

				<TextBlock x:Name="UpdateCheckingLabel"
						  Grid.Column="6"
						  Text="{DynamicResource S.Update.Checking}"
						  FontSize="11"
						  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						  VerticalAlignment="Center"
						  Margin="6,0,0,0"
						  IsVisible="False" />

				<TextBlock x:Name="UpToDateLabel"
						  Grid.Column="7"
						  FontSize="11"
						  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						  VerticalAlignment="Center"
						  Margin="12,0,0,0"
						  IsVisible="False"
						  PointerPressed="OnUpToDateLabelClick"
						  ToolTip.Tip="{DynamicResource S.Update.Recheck.Tooltip}" />

				<Button x:Name="UpdateIndicator"
						Grid.Column="8"
						Content="↓"
						FontSize="14"
						Padding="8,4"
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						IsVisible="False"
						Click="OnUpdateIndicatorClick" />

				<Button x:Name="GitHubLink"
						Grid.Column="9"
						Padding="8,4"
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						Click="OnGitHubLinkClick">
					<Rectangle Width="16"
							   Height="16"
							   Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}">
						<Rectangle.OpacityMask>
							<ImageBrush Source="avares://Cursor-Palette-Linux/Resources/GitHub48.png" Stretch="Uniform" />
						</Rectangle.OpacityMask>
					</Rectangle>
				</Button>
			</Grid>
		</Border>

	</Grid>
	</LayoutTransformControl>

		<!-- Drag ghost overlay -->
		<Border x:Name="DragGhost"
				IsHitTestVisible="False"
				IsVisible="False"
				Opacity="0.85"
				ZIndex="960"
				Width="120"
				Height="120"
				CornerRadius="10"
				BorderThickness="2"
				BorderBrush="CornflowerBlue"
				Background="{DynamicResource SystemControlDefaultChromeMediumBrush}"
				HorizontalAlignment="Left"
				VerticalAlignment="Top">
			<Border.RenderTransform>
				<TranslateTransform />
			</Border.RenderTransform>
			<StackPanel VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Spacing="4">
				<Image x:Name="DragGhostImage"
					   Width="40"
					   Height="40" />
				<TextBlock x:Name="DragGhostText"
						   TextTrimming="CharacterEllipsis"
						   TextAlignment="Center"
						   MaxWidth="108"
						   FontSize="12" />
			</StackPanel>
		</Border>

		<!-- Reorder insertion indicator -->
		<Border x:Name="ReorderInsertionLine"
				IsHitTestVisible="False"
				IsVisible="False"
				ZIndex="950"
				Width="4"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Background="CornflowerBlue"
				CornerRadius="2">
			<Border.RenderTransform>
				<TranslateTransform />
			</Border.RenderTransform>
		</Border>

		<!-- Group attach indicator (shown when dragging preset onto a group) -->
		<Border x:Name="GroupAttachIndicator"
				IsHitTestVisible="False"
				IsVisible="False"
				ZIndex="955"
				BorderThickness="3"
				BorderBrush="{DynamicResource SystemAccentColor}"
				CornerRadius="12"
				HorizontalAlignment="Left"
				VerticalAlignment="Top">
			<Border.RenderTransform>
				<TranslateTransform />
			</Border.RenderTransform>
		</Border>

		<!-- Window drop indicator (dashed border shown on file drag-over) -->
		<Rectangle x:Name="WindowDropIndicator"
				   IsHitTestVisible="False"
				   IsVisible="False"
				   ZIndex="900"
				   Margin="4"
				   Stroke="CornflowerBlue"
				   StrokeThickness="4"
				   StrokeDashArray="6,3"
				   RadiusX="10"
				   RadiusY="10" />
	</Grid>
</Window>
