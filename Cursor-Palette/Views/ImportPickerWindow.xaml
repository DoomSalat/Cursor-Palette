<Window x:Class="CursorPalette.Views.ImportPickerWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Import.Title}"
		Width="520" Height="560" MinWidth="380" MinHeight="320"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="Style.ToggleCheckBox" TargetType="CheckBox">
			<Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border x:Name="Box" Width="18" Height="18"
									CornerRadius="4"
									Background="{StaticResource Brush.Surface}"
									BorderBrush="{StaticResource Brush.Border}"
									BorderThickness="1">
								<Path x:Name="CheckMark"
									  Width="10" Height="8" Stretch="Uniform"
									  Fill="{StaticResource Brush.Accent}"
									  Data="M 0,4 L 3,7 L 9,0"
									  Visibility="Collapsed"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center" />
							</Border>
							<ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
								<Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<DockPanel>
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="TitleText"
						   Text="{DynamicResource S.Import.Title}"
						   FontSize="15" FontWeight="SemiBold"
						   VerticalAlignment="Center" />

				<Button Grid.Column="1"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.SelectAll}"
						Padding="8,5"
						Margin="0,0,8,0"
						Click="OnSelectAllClick" />
				<Button Grid.Column="2"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.SelectNone}"
						Padding="8,5"
						Margin="0,0,8,0"
						Click="OnSelectNoneClick" />
				<Button Grid.Column="3"
						Style="{StaticResource Style.Button}"
						Padding="8,6"
						ToolTip="{DynamicResource S.Info.Tooltip}"
						Click="OnInfoButtonClick">
					<TextBlock Text="ⓘ" FontSize="15" />
				</Button>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="SelectionCountText"
						   Foreground="{StaticResource Brush.TextDim}"
						   FontSize="12"
						   VerticalAlignment="Center" />

				<Button Grid.Column="1"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Editor.Cancel}"
						MinWidth="90"
						Margin="0,0,8,0"
						IsCancel="True" />
				<Button x:Name="ImportButton" Grid.Column="2"
						Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Import.Confirm}"
						MinWidth="110"
						Click="OnImportButtonClick" />
			</Grid>
		</Border>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<StackPanel>
				<CheckBox x:Name="IgnoreSizesCheck"
						  Style="{StaticResource Style.ToggleCheckBox}"
						  Content="{DynamicResource S.Import.IgnoreSizes}"
						  Checked="OnIgnoreSizesChanged"
						  Unchecked="OnIgnoreSizesChanged" />

				<Grid x:Name="UniformSizeRow" Margin="0,10,0,0" Visibility="Collapsed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0" Text="{DynamicResource S.CursorSize}"
							   Foreground="{StaticResource Brush.TextDim}"
							   VerticalAlignment="Center" />
					<Slider x:Name="UniformSizeSlider" Grid.Column="1"
							Style="{StaticResource Style.Slider}"
							MinWidth="90" Margin="8,0"
							Minimum="1" Maximum="15"
							TickFrequency="1" IsSnapToTickEnabled="True"
							VerticalAlignment="Center"
							ValueChanged="OnUniformSizeSliderValueChanged" />
					<TextBlock x:Name="UniformSizeValueText" Grid.Column="2"
							   Width="46"
							   Foreground="{StaticResource Brush.TextDim}"
							   VerticalAlignment="Center" />
				</Grid>
			</StackPanel>
		</Border>

		<Grid Margin="16">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<ItemsControl x:Name="Gallery">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</ScrollViewer>

			<TextBlock x:Name="EmptyHint"
					   Text="{DynamicResource S.Import.Empty}"
					   Foreground="{StaticResource Brush.TextDim}"
					   TextAlignment="Center"
					   TextWrapping="Wrap"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   Visibility="Collapsed" />
		</Grid>
	</DockPanel>
</Window>
