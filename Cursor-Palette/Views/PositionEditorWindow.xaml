<Window x:Class="CursorPalette.Views.PositionEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Position.Title}"
		Width="680" Height="600"
	MinWidth="460" MinHeight="400"
	Style="{StaticResource Style.Window}"
	WindowStartupLocation="CenterOwner"
	ResizeMode="CanResize"
	ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="Style.ArrowButton" TargetType="Button" BasedOn="{StaticResource Style.Button}">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
		</Style>
	</Window.Resources>

	<DockPanel x:Name="RootPanel">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,8">
			<Button Style="{StaticResource Style.Button}"
					Padding="8,6"
					ToolTip="{DynamicResource S.Info.Tooltip}"
					Click="OnInfoButtonClick"
					HorizontalAlignment="Right">
				<TextBlock Text="ⓘ" FontSize="15" />
			</Button>
		</Border>

		<DockPanel Margin="16">
		<TextBlock DockPanel.Dock="Top"
					 Text="{DynamicResource S.Position.Hint}"
					 Foreground="{StaticResource Brush.TextDim}"
					 Margin="0,0,0,12" />

		<Border DockPanel.Dock="Top"
				Style="{StaticResource Style.GroupBorder}"
				Margin="0,0,0,12">
			<Grid VerticalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="14" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0" Text="{DynamicResource S.Position.CanvasWidth}"
							 Foreground="{StaticResource Brush.TextDim}"
							 VerticalAlignment="Center" Margin="0,0,6,0" />
				<TextBox x:Name="CanvasWidthBox" Grid.Column="1"
						 Style="{StaticResource Style.TextBox}"
						 Width="52" VerticalAlignment="Center" />

				<TextBlock Grid.Column="3" Text="{DynamicResource S.Position.CanvasHeight}"
							 Foreground="{StaticResource Brush.TextDim}"
							 VerticalAlignment="Center" Margin="0,0,6,0" />
				<TextBox x:Name="CanvasHeightBox" Grid.Column="4"
						 Style="{StaticResource Style.TextBox}"
						 Width="52" VerticalAlignment="Center" />

				<Button x:Name="ApplyCanvasSizeButton" Grid.Column="6"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Position.ApplyCanvasSize}"
						ToolTip="{DynamicResource S.Position.ApplyCanvasSize.Tooltip}"
						Click="OnApplyCanvasSizeClick" />
			</Grid>
		</Border>

		<Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
				<Button x:Name="UiZoomOutButton"
						Style="{StaticResource Style.Button}"
						Content="−"
						Padding="8,2"
						ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
						Click="OnUiZoomOutClick" />
				<TextBlock x:Name="UiZoomText"
							   Width="40"
							   TextAlignment="Center"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="11"
							   VerticalAlignment="Center" Margin="6,0" />
				<Button x:Name="UiZoomInButton"
						Style="{StaticResource Style.Button}"
						Content="+"
						Padding="8,2"
						ToolTip="{DynamicResource S.UiZoom.InTooltip}"
						Click="OnUiZoomInClick" />
			</StackPanel>

			<TextBlock x:Name="CoordsText" Grid.Column="1"
						 Foreground="{StaticResource Brush.TextDim}"
						 VerticalAlignment="Center"
						 Margin="12,0,0,0" />

			<CheckBox x:Name="ShowSpriteBoundsCheck" Grid.Column="2"
					  Style="{StaticResource Style.ToggleCheckBox}"
					  Content="{DynamicResource S.Position.ShowSpriteBounds}"
					  VerticalAlignment="Center"
					  Margin="12,0,0,0"
					  Checked="OnShowSpriteBoundsChanged"
					  Unchecked="OnShowSpriteBoundsChanged" />

			<Button Grid.Column="4"
					Style="{StaticResource Style.Button}"
					Content="{DynamicResource S.Editor.Cancel}"
					Margin="0,0,8,0" MinWidth="90"
					IsCancel="True" />
			<Button Grid.Column="5"
					Style="{StaticResource Style.AccentButton}"
					Content="{DynamicResource S.Editor.Save}"
					MinWidth="90"
					Click="OnSaveClick" />
		</Grid>

		<ScrollViewer HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Border Background="{DynamicResource Brush.Checkerboard}"
						BorderBrush="{DynamicResource Brush.Accent}"
						BorderThickness="3"
						VerticalAlignment="Center">
					<Canvas x:Name="PreviewCanvas" Background="Transparent">
						<Image x:Name="PreviewImage" SnapsToDevicePixels="True" />
						<Rectangle x:Name="SpriteBoundsRect"
								   Stroke="#FFFF8800"
								   StrokeThickness="2"
								   IsHitTestVisible="False"
								   Visibility="Collapsed" />
					</Canvas>
				</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
				<TextBlock Text="{DynamicResource S.Position.Move}"
							 Foreground="{StaticResource Brush.TextDim}"
							 FontSize="11"
							 HorizontalAlignment="Center"
							 Margin="0,0,0,6" />

				<Grid Width="96" Height="96" HorizontalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<Button x:Name="MoveUpButton" Grid.Row="0" Grid.Column="1"
							Style="{StaticResource Style.ArrowButton}"
							Click="OnMoveUpClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button x:Name="MoveLeftButton" Grid.Row="1" Grid.Column="0"
							Style="{StaticResource Style.ArrowButton}"
							Click="OnMoveLeftClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="180" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Rectangle Grid.Row="1" Grid.Column="1"
							   Fill="{StaticResource Brush.Border}"
							   Width="6" Height="6"
							   RadiusX="3" RadiusY="3" />
					<Button x:Name="MoveRightButton" Grid.Row="1" Grid.Column="2"
							Style="{StaticResource Style.ArrowButton}"
							Click="OnMoveRightClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button x:Name="MoveDownButton" Grid.Row="2" Grid.Column="1"
							Style="{StaticResource Style.ArrowButton}"
							Click="OnMoveDownClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
				</Grid>

				<TextBlock Text="{DynamicResource S.Position.Snap}"
							 Foreground="{StaticResource Brush.TextDim}"
							 FontSize="11"
							 HorizontalAlignment="Center"
							 Margin="0,14,0,6" />
				<UniformGrid x:Name="SnapGrid" Rows="3" Columns="3" Width="96" Height="96" HorizontalAlignment="Center">
					<Button Tag="0,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="180" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/CenterIcon26.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="1,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="0,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnSnapClick">
						<Rectangle Width="16" Height="16" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
				</UniformGrid>
			</StackPanel>
		</StackPanel>
		</ScrollViewer>
		</DockPanel>
	</DockPanel>
</Window>
