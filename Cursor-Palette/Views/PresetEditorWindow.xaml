<Window x:Class="CursorPalette.Views.PresetEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Editor.TitleNew}"
		Width="760" Height="640" MinWidth="600" MinHeight="480"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">

	<DockPanel>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
							 Text="{DynamicResource S.Editor.PresetName}"
							 Foreground="{StaticResource Brush.TextDim}"
							 VerticalAlignment="Center" Margin="0,0,8,0" />
				<TextBox x:Name="NameBox" Grid.Column="1"
						 Style="{StaticResource Style.TextBox}"
						 VerticalAlignment="Center" MaxLength="60" />

				<Button Grid.Column="2"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Editor.Cancel}"
						Margin="12,0,8,0" MinWidth="90"
						IsCancel="True" />
				<Button Grid.Column="3"
						Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Editor.Save}"
						MinWidth="110"
						Click="SaveButton_Click" />
			</Grid>
		</Border>

		<TextBlock DockPanel.Dock="Top"
					 Text="{DynamicResource S.Editor.SlotHint}"
					 Foreground="{StaticResource Brush.TextDim}"
					 Margin="16,12,16,4" />

		<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4">
			<ItemsControl x:Name="Slots">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</ScrollViewer>

	</DockPanel>
</Window>
