<Window x:Class="CursorPalette.Views.CanvasSizeDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.CanvasSize.Title}"
		Width="420" Height="560"
		MinWidth="380" MinHeight="480"
		ResizeMode="CanResize"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		Style="{StaticResource Style.Window}">

	<DockPanel Margin="20">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Style="{StaticResource Style.Button}"
					Content="{DynamicResource S.CanvasSize.Cancel}"
					MinWidth="88" Margin="0,0,8,0"
					IsCancel="True" />
			<Button x:Name="ApplyButton"
					Style="{StaticResource Style.AccentButton}"
					Content="{DynamicResource S.CanvasSize.Apply}"
					MinWidth="88"
					IsDefault="True"
					Click="OnApplyClick" />
		</StackPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel>
				<Grid Margin="0,0,0,18">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0" Text="{DynamicResource S.CanvasSize.Preset}"
							   VerticalAlignment="Center" Margin="0,0,10,0" />
					<ComboBox x:Name="PresetCombo" Grid.Column="1"
							  Style="{StaticResource Style.ComboBox}"
							  VerticalAlignment="Center"
							  SelectionChanged="OnPresetSelectionChanged" />
				</Grid>

				<Grid Margin="0,0,0,18">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0" Text="{DynamicResource S.CanvasSize.Width}"
							   VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBox x:Name="WidthBox" Grid.Column="1"
							 Style="{StaticResource Style.TextBox}"
							 VerticalAlignment="Center" MaxLength="3"
							 PreviewTextInput="OnTextInputDigits" />
					<TextBlock Grid.Column="2" Text="{DynamicResource S.CanvasSize.Height}"
							   VerticalAlignment="Center" Margin="16,0,8,0" />
					<TextBox x:Name="HeightBox" Grid.Column="3"
							 Style="{StaticResource Style.TextBox}"
							 VerticalAlignment="Center" MaxLength="3"
							 PreviewTextInput="OnTextInputDigits" />
				</Grid>

				<TextBlock Text="{DynamicResource S.CanvasSize.Anchor}"
						   Foreground="{StaticResource Brush.TextDim}"
						   FontSize="12"
						   Margin="0,0,0,8" />

				<UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="112" Height="112" HorizontalAlignment="Left" Margin="0,0,0,18">
					<Button Tag="0,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="2,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="180" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/CenterIcon26.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="2,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="0,2" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,2" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="2,2" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnAnchorClick">
						<Rectangle Width="18" Height="18" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
				</UniformGrid>

				<TextBlock Text="{DynamicResource S.CanvasSize.Current}"
						   Foreground="{StaticResource Brush.TextDim}"
						   FontSize="12"
						   Margin="0,0,0,6" />
				<Canvas x:Name="PreviewCanvas" Width="232" Height="140" Background="{StaticResource Brush.SurfaceHover}" ClipToBounds="True" Margin="0,0,0,0">
					<Rectangle x:Name="CurrentRect" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="1" StrokeDashArray="4,2" Fill="#40000000" />
					<Rectangle x:Name="NewRect" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" Fill="Transparent" />
				</Canvas>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</Window>
