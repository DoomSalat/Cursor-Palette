<Window x:Class="CursorPalette.Views.PaintEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:CursorPalette.Controls"
		Title="{DynamicResource S.Paint.Title}"
		Width="820" Height="680"
	MinWidth="560" MinHeight="460"
	Style="{StaticResource Style.Window}"
	WindowStartupLocation="CenterOwner"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	AllowDrop="True"
	Loaded="OnWindowLoaded"
	PreviewKeyDown="OnWindowPreviewKeyDown"
	PreviewKeyUp="OnWindowPreviewKeyUp">

	<Window.Resources>
		<Style x:Key="Style.ArrowButton" TargetType="Button" BasedOn="{StaticResource Style.Button}">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Width" Value="36" />
			<Setter Property="Height" Value="36" />
		</Style>

		<Style x:Key="Style.ToolButton" TargetType="ToggleButton">
			<Setter Property="Background" Value="{StaticResource Brush.Surface}" />
			<Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
			<Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="MinWidth" Value="44" />
			<Setter Property="MinHeight" Value="40" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background"
										Value="{StaticResource Brush.SurfaceHover}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background"
										Value="{StaticResource Brush.Accent}" />
								<Setter TargetName="Bd" Property="BorderBrush"
										Value="{StaticResource Brush.Accent}" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Style.ResizeThumbCorner" TargetType="Thumb">
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Style.ResizeThumbEdge" TargetType="Thumb">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" />
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
								<Setter TargetName="Bd" Property="Opacity" Value="0.35" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Style.PlayStopButton.Playing" TargetType="Button" BasedOn="{StaticResource Style.Button}">
			<Setter Property="Background" Value="#FFDC2626" />
			<Setter Property="BorderBrush" Value="#FFDC2626" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#FFB91C1C" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="#FFB91C1C" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
	<DockPanel x:Name="RootPanel">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.SurfaceHover}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="18,10">
			<DockPanel>
				<TextBlock Text="{DynamicResource S.Paint.Title}"
						   FontWeight="SemiBold"
						   FontSize="15"
						   VerticalAlignment="Center" />

				<StackPanel DockPanel.Dock="Right"
							Orientation="Horizontal"
							VerticalAlignment="Center">
					<Button x:Name="CanvasSizeButton"
							Style="{StaticResource Style.Button}"
							Padding="10,6"
							Margin="8,0,0,0"
							ToolTip="{DynamicResource S.Editor.CanvasSize.Tooltip}"
							Click="OnCanvasSizeButtonClick">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{DynamicResource S.Editor.CanvasSize}" VerticalAlignment="Center" />
							<TextBlock x:Name="CanvasSizeLabel"
									   Foreground="{StaticResource Brush.TextDim}"
									   FontSize="12"
									   VerticalAlignment="Center"
									   Margin="6,0,0,0" />
						</StackPanel>
					</Button>
				<Grid Margin="8,0,0,0">
				<Button x:Name="ImportImageButton"
					Style="{StaticResource Style.Button}"
					Padding="10,6"
					ToolTip="{DynamicResource S.ImportImage.Tooltip}"
					Click="OnImportImageClick"
					AllowDrop="True"
					DragEnter="OnImportButtonDragEnter"
					DragOver="OnImportButtonDragOver"
					DragLeave="OnImportButtonDragLeave"
					Drop="OnImportButtonDrop">
					<StackPanel Orientation="Horizontal">
						<Rectangle Width="18" Height="18"
								Fill="{StaticResource Brush.Text}"
								VerticalAlignment="Center">
								<Rectangle.OpacityMask>
									<ImageBrush ImageSource="pack://application:,,,/Resources/DownloadIcon32.png" Stretch="Uniform" />
								</Rectangle.OpacityMask>
						</Rectangle>
						<TextBlock Text="{DynamicResource S.ImportImage.Button}"
								VerticalAlignment="Center"
								Margin="6,0,0,0" />
					</StackPanel>
				</Button>
				<Rectangle x:Name="ImportDropIndicator"
						   Stroke="{StaticResource Brush.Accent}"
						   StrokeThickness="2"
						   StrokeDashArray="4 2"
						   RadiusX="6" RadiusY="6"
						   IsHitTestVisible="False"
						   Visibility="Collapsed" />
			</Grid>
					<Button Style="{StaticResource Style.Button}"
							Padding="10,8"
							Margin="8,0,0,0"
							ToolTip="{DynamicResource S.Info.Tooltip}"
							Click="OnInfoButtonClick">
						<TextBlock Text="ⓘ" FontSize="16" />
					</Button>
				</StackPanel>

				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
					<ToggleButton x:Name="ToolHandButton"
								  Style="{StaticResource Style.ToolButton}"
								  ToolTip="{DynamicResource S.Editor.Tool.Hand}"
								  Click="OnToolHandClick">
						<TextBlock Text="✋" FontSize="16" />
					</ToggleButton>
					<ToggleButton x:Name="ToolMoveButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Move}"
								  Click="OnToolMoveClick">
						<TextBlock Text="✥" FontSize="18" />
					</ToggleButton>
					<ToggleButton x:Name="ToolBrushButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Brush}"
								  Click="OnToolBrushClick">
						<Rectangle Width="18" Height="18"
								   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/PencilIcon48.png" Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</ToggleButton>
					<ToggleButton x:Name="ToolEraserButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Eraser}"
								  Click="OnToolEraserClick">
						<Rectangle Width="18" Height="18"
								   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/EraseIcon32.png" Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</ToggleButton>
					<ToggleButton x:Name="ToolFillButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Fill}"
								  Click="OnToolFillClick">
						<Rectangle Width="18" Height="18"
								   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/FillIcon32.png" Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</ToggleButton>
					<ToggleButton x:Name="ToolCanvasButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Canvas}"
								  Click="OnToolCanvasClick">
						<TextBlock Text="⛶" FontSize="16" />
					</ToggleButton>
					<ToggleButton x:Name="ToolHotspotButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.Hotspot}"
								  Click="OnToolHotspotClick">
						<TextBlock Text="🎯" FontSize="16" />
					</ToggleButton>
					<ToggleButton x:Name="ToolBgRefButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.BgRef}"
								  Click="OnToolBgRefClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ImageRefIcon32.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</ToggleButton>
					<ToggleButton x:Name="ToolIconSizesButton"
								  Style="{StaticResource Style.ToolButton}"
								  Margin="4,0,0,0"
								  ToolTip="{DynamicResource S.Editor.Tool.IconSizes}"
								  Click="OnToolIconSizesClick">
						<Rectangle Width="18" Height="18"
								   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/SizeChangeIcon32.png" Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</ToggleButton>

					<Border Width="1" Height="28" Background="{StaticResource Brush.Border}" Margin="8,0,4,0" />

					<Button x:Name="UndoButton"
							Style="{StaticResource Style.Button}"
							Padding="8,6"
							Margin="0,0,4,0"
							MinWidth="44"
							MinHeight="40"
							ToolTip="{DynamicResource S.Editor.Undo.Tooltip}"
							Click="OnUndoClick">
						<TextBlock Text="↶" FontSize="18" />
					</Button>
					<Button x:Name="RedoButton"
							Style="{StaticResource Style.Button}"
							Padding="8,6"
							Margin="0,0,0,0"
							MinWidth="44"
							MinHeight="40"
							ToolTip="{DynamicResource S.Editor.Redo.Tooltip}"
							Click="OnRedoClick">
						<TextBlock Text="↷" FontSize="18" />
					</Button>
				</StackPanel>
			</DockPanel>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="18,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource S.Editor.Zoom}"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Margin="0,0,6,0" />
					<Button x:Name="CanvasZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="−"
							Padding="10,4"
							ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
							Click="OnCanvasZoomOutClick" />
					<TextBlock x:Name="CanvasZoomText"
							   Width="50"
							   TextAlignment="Center"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="12"
							   VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="CanvasZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="+"
							Padding="10,4"
							ToolTip="{DynamicResource S.UiZoom.InTooltip}"
							Click="OnCanvasZoomInClick" />
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
					<Button x:Name="UiZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="−"
							Padding="10,4"
							ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
							Click="OnUiZoomOutClick" />
					<TextBlock x:Name="UiZoomText"
								   Width="44"
								   TextAlignment="Center"
								   Foreground="{StaticResource Brush.TextDim}"
								   FontSize="12"
								   VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="UiZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="+"
							Padding="10,4"
							ToolTip="{DynamicResource S.UiZoom.InTooltip}"
							Click="OnUiZoomInClick" />
					<Button x:Name="ExportPngButton"
							Style="{StaticResource Style.Button}"
							Padding="10,4"
							Margin="8,0,0,0"
							ToolTip="{DynamicResource S.Editor.ExportPng}"
							Click="OnExportPngClick">
						<StackPanel Orientation="Horizontal">
							<Rectangle Width="18" Height="18"
									   Fill="{StaticResource Brush.TextDim}"
									   RenderTransformOrigin="0.5,0.5"
									   VerticalAlignment="Center">
								<Rectangle.OpacityMask>
									<ImageBrush ImageSource="pack://application:,,,/Resources/DownloadIcon32.png" Stretch="Uniform" />
								</Rectangle.OpacityMask>
							</Rectangle>
							<TextBlock Text=".png"
									   Foreground="{StaticResource Brush.TextDim}"
									   FontSize="12"
									   VerticalAlignment="Center"
									   Margin="6,0,0,0" />
						</StackPanel>
					</Button>
					<Button x:Name="ExportGifButton"
							Style="{StaticResource Style.Button}"
							Padding="10,4"
							Margin="8,0,0,0"
							Visibility="Collapsed"
							ToolTip="{DynamicResource S.Editor.ExportGif}"
							Click="OnExportGifClick">
						<StackPanel Orientation="Horizontal">
							<Rectangle Width="18" Height="18"
									   Fill="{StaticResource Brush.TextDim}"
									   RenderTransformOrigin="0.5,0.5"
									   VerticalAlignment="Center">
								<Rectangle.OpacityMask>
									<ImageBrush ImageSource="pack://application:,,,/Resources/DownloadIcon32.png" Stretch="Uniform" />
								</Rectangle.OpacityMask>
							</Rectangle>
							<TextBlock Text=".gif"
									   Foreground="{StaticResource Brush.TextDim}"
									   FontSize="12"
									   VerticalAlignment="Center"
									   Margin="6,0,0,0" />
						</StackPanel>
					</Button>
				</StackPanel>

				<TextBlock x:Name="CoordsText" Grid.Column="2"
							 Foreground="{StaticResource Brush.TextDim}"
							 VerticalAlignment="Center"
							 Margin="12,0,0,0" />

				<CheckBox x:Name="ShowSpriteBoundsCheck" Grid.Column="3"
						  Style="{StaticResource Style.ToggleCheckBox}"
						  Content="{DynamicResource S.Position.ShowSpriteBounds}"
						  VerticalAlignment="Center"
						  Margin="12,0,0,0"
						  Checked="OnShowSpriteBoundsChanged"
						  Unchecked="OnShowSpriteBoundsChanged" />

				<Button Grid.Column="5"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Editor.Cancel}"
						Padding="12,7"
						Margin="0,0,8,0" MinWidth="100"
						IsCancel="True" />
				<Button x:Name="SaveButton" Grid.Column="6"
						Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Editor.Save}"
						Padding="12,7"
						MinWidth="100"
						IsDefault="True"
						Click="OnSaveClick" />
			</Grid>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.SurfaceHover}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="18,8">
			<StackPanel>
				<DockPanel>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="PlayStopButton"
								Style="{StaticResource Style.Button}"
								Content="▶"
								FontSize="14"
								Width="40"
								Padding="0,4"
								Margin="32,0,0,0"
								ToolTip="{DynamicResource S.Editor.Timeline.Play}"
								Click="OnPlayStopClick" />
						<Button x:Name="AddFrameButton"
								Style="{StaticResource Style.Button}"
								Content="+"
								Padding="12,4"
								Margin="12,0,0,0"
								ToolTip="{DynamicResource S.Editor.Timeline.AddFrame}"
								Click="OnAddFrameClick" />
						<Button x:Name="RemoveFrameButton"
								Style="{StaticResource Style.Button}"
								Content="−"
								Padding="12,4"
								Margin="4,0,0,0"
								ToolTip="{DynamicResource S.Editor.Timeline.RemoveFrame}"
								Click="OnRemoveFrameClick" />

						<TextBlock Text="{DynamicResource S.Editor.Timeline.Duration}"
								   Foreground="{StaticResource Brush.TextDim}"
								   FontSize="11"
								   VerticalAlignment="Center"
								   Margin="16,0,6,0" />
						<TextBox x:Name="FrameDurationBox"
								 Style="{StaticResource Style.TextBox}"
								 Width="52"
								 Padding="4,2"
								 HorizontalContentAlignment="Center"
								 Text="100"
								 TextChanged="OnFrameDurationChanged" />
						<CheckBox x:Name="UseDurationForAllCheck"
								  Style="{StaticResource Style.ToggleCheckBox}"
								  Content="{DynamicResource S.Editor.Timeline.UseForAll}"
								  VerticalAlignment="Center"
								  Margin="8,0,0,0"
								  Checked="OnUseDurationForAllChanged"
								  Unchecked="OnUseDurationForAllChanged" />

						<CheckBox x:Name="ManualRefCheck"
								  Style="{StaticResource Style.ToggleCheckBox}"
								  Content="{DynamicResource S.Editor.Timeline.ManualRef}"
								  VerticalAlignment="Center"
								  Margin="16,0,0,0"
								  Checked="OnManualRefChanged"
								  Unchecked="OnManualRefChanged" />
					</StackPanel>

					<TextBlock DockPanel.Dock="Right"
							   Text="{DynamicResource S.Editor.Timeline.LimitNote}"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="10"
							   VerticalAlignment="Center"
							   HorizontalAlignment="Right" />
					<Grid />
				</DockPanel>

				<Separator Height="1"
						   Background="{StaticResource Brush.Border}"
						   Margin="0,8,0,0"
						   SnapsToDevicePixels="True" />

				<ScrollViewer HorizontalScrollBarVisibility="Auto"
							  VerticalScrollBarVisibility="Disabled"
							  Margin="0,8,0,0">
					<StackPanel x:Name="TimelineFramesPanel" Orientation="Horizontal" />
				</ScrollViewer>
			</StackPanel>
		</Border>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition x:Name="ToolPanelColumn" Width="176" MinWidth="176" MaxWidth="400" />
			</Grid.ColumnDefinitions>

			<Grid x:Name="ViewportHost"
				  Grid.Column="0"
				  Background="{StaticResource Brush.Bg}"
				  ClipToBounds="True"
				  AllowDrop="True"
				  DragEnter="OnCanvasDragEnter"
				  DragOver="OnCanvasDragOver"
				  DragLeave="OnCanvasDragLeave"
				  Drop="OnCanvasDrop"
				  PreviewMouseWheel="OnViewportMouseWheel"
				  PreviewMouseDown="OnViewportPreviewMouseDown"
				  PreviewMouseMove="OnViewportPreviewMouseMove"
				  PreviewMouseUp="OnViewportPreviewMouseUp"
			  MouseLeave="OnViewportMouseLeave">
				<Canvas x:Name="ViewportContent" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" UseLayoutRounding="False">
					<Canvas.RenderTransform>
						<TransformGroup>
							<ScaleTransform x:Name="CanvasZoomTransform" ScaleX="8" ScaleY="8" />
							<TranslateTransform x:Name="CanvasPanTransform" X="0" Y="0" />
						</TransformGroup>
					</Canvas.RenderTransform>
					<Rectangle x:Name="ShadowRect" Stroke="{StaticResource Brush.TextDim}" StrokeThickness="1" StrokeDashArray="4,2" Fill="#40000000" IsHitTestVisible="False" Visibility="Collapsed" />
					<Rectangle x:Name="CanvasBgRect" Fill="{DynamicResource Brush.Checkerboard}" />
					<Image x:Name="BgRefImage" IsHitTestVisible="False" Visibility="Collapsed" />
					<Image x:Name="PreviewImage" SnapsToDevicePixels="True" IsHitTestVisible="False" />
					<Rectangle x:Name="SpriteBoundsRect" Stroke="#FFFF8800" StrokeThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
					<Rectangle x:Name="PaintCursorRect" Width="1" Height="1" Stroke="#FFFFFFFF" StrokeThickness="0.05" IsHitTestVisible="False" Visibility="Collapsed" />
					<Ellipse x:Name="HotspotMarkerGlow" Width="2" Height="2" Fill="{StaticResource Brush.Accent}" Opacity="0.3" IsHitTestVisible="False" Visibility="Collapsed" />
					<Ellipse x:Name="HotspotMarker" Width="1.5" Height="1.5" Fill="{StaticResource Brush.Accent}" Stroke="White" StrokeThickness="0.15" IsHitTestVisible="False" Visibility="Collapsed" />
					<Canvas x:Name="ResizeOverlay" IsHitTestVisible="True" UseLayoutRounding="False" Visibility="Collapsed">
						<Rectangle x:Name="CanvasBorderRect" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" IsHitTestVisible="False" />
						<Thumb x:Name="ThumbTop" Style="{StaticResource Style.ResizeThumbEdge}" Cursor="SizeNS" DragDelta="OnThumbTopDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbBottom" Style="{StaticResource Style.ResizeThumbEdge}" Cursor="SizeNS" DragDelta="OnThumbBottomDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbLeft" Style="{StaticResource Style.ResizeThumbEdge}" Cursor="SizeWE" DragDelta="OnThumbLeftDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbRight" Style="{StaticResource Style.ResizeThumbEdge}" Cursor="SizeWE" DragDelta="OnThumbRightDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbTopLeft" Style="{StaticResource Style.ResizeThumbCorner}" Cursor="SizeNWSE" DragDelta="OnThumbTopLeftDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbTopRight" Style="{StaticResource Style.ResizeThumbCorner}" Cursor="SizeNESW" DragDelta="OnThumbTopRightDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
						<Thumb x:Name="ThumbBottomLeft" Style="{StaticResource Style.ResizeThumbCorner}" Cursor="SizeNESW" DragDelta="OnThumbBottomLeftDrag" DragStarted="OnResizeStarted" DragCompleted="OnResizeCompleted" />
