<Window x:Class="CursorPalette.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:CursorPalette"
		xmlns:services="clr-namespace:CursorPalette.Services"
		Title="{DynamicResource S.AppTitle}"
		Icon="pack://application:,,,/app.ico"
		Width="860" Height="640" MinWidth="620" MinHeight="440"
		Style="{StaticResource Style.Window}"
		AllowDrop="True"
		Drop="OnWindowDrop"
		DragOver="OnWindowDragOver">

	<!-- LayoutTransform на корневой панели — общий зум интерфейса (шапка,
		 тулбар, футер, галерея) управляется кнопками -/+ внизу слева. -->
	<DockPanel x:Name="RootPanel">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Path Width="18" Height="18"
						  Stretch="Uniform"
						  Fill="{StaticResource Brush.Accent}"
						  Margin="0,0,8,0"
						  Data="M 0,0 L 0,16 L 4.5,12 L 7,18 L 9,17 L 6.5,11 L 12,11 Z" />
					<TextBlock Text="Cursor"
						   FontSize="16" FontWeight="SemiBold"
						   VerticalAlignment="Center" />
					<TextBlock Text="Palette"
						   FontSize="16" FontWeight="SemiBold"
						   Foreground="{StaticResource Brush.Accent}"
						   VerticalAlignment="Center"
						   Margin="2,0,0,0" />
				</StackPanel>

				<Button x:Name="ThemeToggleButton" Grid.Column="2"
						Style="{StaticResource Style.Button}"
						Padding="8,6"
						ToolTip="{DynamicResource S.Theme.ToggleTooltip}"
						Click="OnThemeToggleClick">
					<TextBlock x:Name="ThemeToggleIcon" FontSize="15" />
				</Button>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource S.GallerySize}"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="0,0,8,0" />
					<Slider x:Name="CellScaleSlider"
							Style="{StaticResource Style.Slider}"
							Width="140"
							Minimum="{x:Static services:AppState.GalleryCellScaleMin}"
							Maximum="{x:Static services:AppState.GalleryCellScaleMax}"
							TickFrequency="0.1" IsSnapToTickEnabled="True"
							VerticalAlignment="Center"
							ValueChanged="OnCellScaleSliderValueChanged" />
					<TextBlock x:Name="CellScaleValueText"
								 Width="46"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="8,0,0,0" />
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
							Margin="0,0,16,0">
					<TextBlock Text="{DynamicResource S.CursorSize}"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="0,0,8,0" />
					<Slider x:Name="SizeSlider"
							Style="{StaticResource Style.Slider}"
							Width="160"
							Minimum="1" Maximum="15"
							TickFrequency="1" IsSnapToTickEnabled="True"
							VerticalAlignment="Center"
							ValueChanged="OnSizeSliderValueChanged" />
					<TextBlock x:Name="SizeValueText"
								 Width="46"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="8,0,0,0" />
					<Button x:Name="ApplySizeButton"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.ApplySize}"
							ToolTip="{DynamicResource S.ApplySize.Tooltip}"
							Margin="8,0,0,0"
							Click="OnApplySizeButtonClick" />
				</StackPanel>

				<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UndoButton"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.Undo}"
							ToolTip="{DynamicResource S.Undo.Tooltip}"
							Click="OnUndoButtonClick" />
				</StackPanel>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,4">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Зум интерфейса (как в VSCode) — внизу слева, сохраняется между запусками. -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UiZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="−"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
							Click="OnUiZoomOutClick" />
					<TextBlock x:Name="UiZoomText"
								 Width="40"
								 TextAlignment="Center"
								 Foreground="{StaticResource Brush.TextDim}"
								 FontSize="11"
								 VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="UiZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="+"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.InTooltip}"
							Click="OnUiZoomInClick" />
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
					<TextBlock x:Name="FooterText"
								 Foreground="{StaticResource Brush.TextDim}"
								 FontSize="11"
								 VerticalAlignment="Center"
								 Cursor="Hand">
						<Hyperlink x:Name="FooterLink"
									  Foreground="{StaticResource Brush.TextDim}"
									  TextDecorations="None"
									  ToolTip="{DynamicResource S.About.LicenseHint}"
									  Click="OnFooterClick">
							<Run x:Name="FooterRun" />
						</Hyperlink>
					</TextBlock>
					<Border Margin="8,0,0,0"
							Cursor="Hand"
							ToolTip="{x:Static local:AppInfo.GitHubUrl}"
							MouseLeftButtonUp="OnGitHubIconClick">
						<Image Source="pack://application:,,,/Resources/GitHub48.png"
							   Width="20" Height="20"
							   SnapsToDevicePixels="True"
							   RenderOptions.BitmapScalingMode="HighQuality" />
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
			<StackPanel>
				<TextBlock x:Name="EmptyHint"
							 Text="{DynamicResource S.EmptyGallery}"
							 Foreground="{StaticResource Brush.TextDim}"
							 TextWrapping="Wrap"
							 Margin="8,16"
							 Visibility="Collapsed" />

				<ItemsControl x:Name="Gallery">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

	</DockPanel>
</Window>
