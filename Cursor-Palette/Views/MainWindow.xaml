<Window x:Class="CursorPalette.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.AppTitle}"
		Icon="pack://application:,,,/app.ico"
		Width="860" Height="600" MinWidth="560" MinHeight="400"
		Style="{StaticResource Style.Window}"
		AllowDrop="True"
		Drop="OnWindowDrop"
		DragOver="OnWindowDragOver">

	<DockPanel>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Grid.Column="0"
							 Text="{DynamicResource S.AppTitle}"
							 FontSize="16" FontWeight="SemiBold"
							 VerticalAlignment="Center" />

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
							Margin="0,0,16,0">
					<TextBlock Text="{DynamicResource S.CursorSize}"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="0,0,8,0" />
					<Slider x:Name="SizeSlider"
							Style="{StaticResource Style.Slider}"
							Width="160"
							Minimum="1" Maximum="15"
							TickFrequency="1" IsSnapToTickEnabled="True"
							VerticalAlignment="Center"
							ValueChanged="OnSizeSliderValueChanged" />
					<TextBlock x:Name="SizeValueText"
								 Width="46"
								 Foreground="{StaticResource Brush.TextDim}"
								 VerticalAlignment="Center" Margin="8,0,0,0" />
					<Button x:Name="ApplySizeButton"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.ApplySize}"
							ToolTip="{DynamicResource S.ApplySize.Tooltip}"
							Margin="8,0,0,0"
							Click="OnApplySizeButtonClick" />
				</StackPanel>

				<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UndoButton"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.Undo}"
							ToolTip="{DynamicResource S.Undo.Tooltip}"
							Click="OnUndoButtonClick" />
				</StackPanel>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,4">
			<TextBlock x:Name="FooterText"
						 Foreground="{StaticResource Brush.TextDim}"
						 FontSize="11"
						 HorizontalAlignment="Right" />
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
			<StackPanel>
				<TextBlock x:Name="EmptyHint"
							 Text="{DynamicResource S.EmptyGallery}"
							 Foreground="{StaticResource Brush.TextDim}"
							 TextWrapping="Wrap"
							 Margin="8,16"
							 Visibility="Collapsed" />

				<ItemsControl x:Name="Gallery">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

	</DockPanel>
</Window>
