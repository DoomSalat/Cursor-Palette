<Window x:Class="CursorPalette.Views.ExportWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Export.Title}"
		Width="580" Height="600" MinWidth="400" MinHeight="360"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">

	<Grid x:Name="RootGrid">
		<DockPanel>
			<DockPanel.LayoutTransform>
				<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
			</DockPanel.LayoutTransform>

			<Border DockPanel.Dock="Top"
					Background="{StaticResource Brush.Surface}"
					BorderBrush="{StaticResource Brush.Border}"
					BorderThickness="0,0,0,1"
					Padding="16,12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBlock Text="{DynamicResource S.Export.Title}"
							   FontSize="15" FontWeight="SemiBold"
							   VerticalAlignment="Center" />

					<Button Grid.Column="1"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.SelectAll}"
							Padding="8,5"
							Margin="0,0,8,0"
							Click="OnSelectAllClick" />
					<Button Grid.Column="2"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.SelectNone}"
							Padding="8,5"
							Margin="0,0,8,0"
							Click="OnSelectNoneClick" />
					<Button Grid.Column="3"
							Style="{StaticResource Style.Button}"
							Padding="8,6"
							ToolTip="{DynamicResource S.Info.Tooltip}"
							Click="OnInfoButtonClick">
						<TextBlock Text="ⓘ" FontSize="15" />
					</Button>
				</Grid>
			</Border>

			<Border DockPanel.Dock="Bottom"
					Background="{StaticResource Brush.Surface}"
					BorderBrush="{StaticResource Brush.Border}"
					BorderThickness="0,1,0,0"
					Padding="16,10">
				<StackPanel>
					<Grid Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Text="{DynamicResource S.Export.Name}"
								   Foreground="{StaticResource Brush.TextDim}"
								   VerticalAlignment="Center" Margin="0,0,8,0" />
						<TextBox x:Name="ExportNameBox" Grid.Column="1"
								 Style="{StaticResource Style.TextBox}"
								 ToolTip="{DynamicResource S.Export.Name.Tooltip}"
								 VerticalAlignment="Center" MaxLength="60" />
					</Grid>

					<TextBlock x:Name="SelectionCountText"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="12"
							   Margin="0,0,0,8" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
							<Button Style="{StaticResource Style.Button}"
									Content="{DynamicResource S.Editor.Cancel}"
									MinWidth="90"
									IsCancel="True" />
							<Button Style="{StaticResource Style.Button}"
									Padding="8,6"
									Margin="8,0,0,0"
									ToolTip="{DynamicResource S.Export.DownloadReadme.Tooltip}"
									Click="OnDownloadReadmeClick">
								<Rectangle Width="16" Height="16"
										   SnapsToDevicePixels="True"
										   Fill="{StaticResource Brush.TextDim}">
									<Rectangle.OpacityMask>
										<ImageBrush ImageSource="pack://application:,,,/Resources/ReadmeIcon32.png"
													Stretch="Uniform" />
									</Rectangle.OpacityMask>
								</Rectangle>
							</Button>
						</StackPanel>

						<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
							<Button x:Name="ExportArchiveButton"
									Style="{StaticResource Style.Button}"
									Content="{DynamicResource S.Export.AsArchive}"
									ToolTip="{DynamicResource S.Export.AsArchive.Tooltip}"
									Padding="12,7"
									Click="OnExportArchiveClick" />
							<Button x:Name="ExportArchiveMoreButton"
									Style="{StaticResource Style.Button}"
									Content="▾"
									Padding="8,7"
									Margin="1,0,0,0"
									ToolTip="{DynamicResource S.Export.MoreOptions.Tooltip}"
									Click="OnExportArchiveMoreClick" />
						</StackPanel>
						<Button x:Name="ExportBundleButton" Grid.Column="2"
								Style="{StaticResource Style.AccentButton}"
								Content="{DynamicResource S.Export.AsBundle}"
								ToolTip="{DynamicResource S.Export.AsBundle.Tooltip}"
								Padding="12,7"
								Click="OnExportBundleClick" />
					</Grid>
				</StackPanel>
			</Border>

			<Grid>
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,0,0" Margin="0,0,6,0">
					<ItemsControl x:Name="Gallery">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</ScrollViewer>

				<TextBlock x:Name="EmptyHint"
						   Text="{DynamicResource S.Export.Empty}"
						   Foreground="{StaticResource Brush.TextDim}"
						   TextAlignment="Center"
						   TextWrapping="Wrap"
						   Margin="16"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   Visibility="Collapsed" />
			</Grid>
		</DockPanel>
	</Grid>
</Window>
