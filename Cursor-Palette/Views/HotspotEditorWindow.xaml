<Window x:Class="CursorPalette.Views.HotspotEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Hotspot.Title}"
		SizeToContent="WidthAndHeight"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ResizeMode="NoResize"
		ShowInTaskbar="False">

	<DockPanel x:Name="RootPanel" Margin="16">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<TextBlock DockPanel.Dock="Top"
					 Text="{DynamicResource S.Hotspot.Hint}"
					 Foreground="{StaticResource Brush.TextDim}"
					 Margin="0,0,0,12" />

		<Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock x:Name="CoordsText" Grid.Column="0"
						 Foreground="{StaticResource Brush.TextDim}"
						 VerticalAlignment="Center" />

			<Button Grid.Column="2"
					Style="{StaticResource Style.Button}"
					Content="{DynamicResource S.Editor.Cancel}"
					Margin="0,0,8,0" MinWidth="90"
					IsCancel="True" />
			<Button Grid.Column="3"
					Style="{StaticResource Style.AccentButton}"
					Content="{DynamicResource S.Editor.Save}"
					MinWidth="90"
					Click="OnSaveClick" />
		</Grid>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
			<Border Background="{StaticResource Brush.Bg}"
					BorderBrush="{StaticResource Brush.Border}"
					BorderThickness="1"
					CornerRadius="6"
					VerticalAlignment="Center">
				<Canvas x:Name="PreviewCanvas"
						Background="Transparent"
						Cursor="Cross"
						MouseLeftButtonDown="OnCanvasMouseDown"
						MouseMove="OnCanvasMouseMove"
						MouseLeftButtonUp="OnCanvasMouseUp">
					<Image x:Name="PreviewImage" SnapsToDevicePixels="True" />
					<Ellipse x:Name="MarkerGlow"
							 Width="20" Height="20"
							 Fill="{StaticResource Brush.Accent}"
							 Opacity="0.3"
							 IsHitTestVisible="False" />
					<Ellipse x:Name="Marker"
							 Width="12" Height="12"
							 Fill="{StaticResource Brush.Accent}"
							 Stroke="White"
							 StrokeThickness="2"
							 IsHitTestVisible="False" />
				</Canvas>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
				<TextBlock Text="{DynamicResource S.Hotspot.Presets}"
							 Foreground="{StaticResource Brush.TextDim}"
							 FontSize="11"
							 HorizontalAlignment="Center"
							 Margin="0,0,0,6" />
				<UniformGrid x:Name="PresetGrid" Rows="3" Columns="3" Width="114" Height="114">
					<Button Tag="0,0" Content="↖" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="0.5,0" Content="↑" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="1,0" Content="↗" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="0,0.5" Content="←" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="0.5,0.5" Content="•" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="1,0.5" Content="→" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="0,1" Content="↙" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="0.5,1" Content="↓" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
					<Button Tag="1,1" Content="↘" Style="{StaticResource Style.Button}" Margin="2" Click="OnPresetPositionClick" />
				</UniformGrid>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>
