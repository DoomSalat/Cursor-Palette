<Window x:Class="CursorPalette.Views.HotspotEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.HotspotEditor.Title}"
		Width="680" Height="600"
	MinWidth="460" MinHeight="400"
	Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ResizeMode="CanResize"
		ShowInTaskbar="False">

	<DockPanel x:Name="RootPanel">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.SurfaceHover}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,8">
			<DockPanel>
				<TextBlock Text="{DynamicResource S.HotspotEditor.Title}"
						   FontWeight="SemiBold"
						   FontSize="14"
						   VerticalAlignment="Center" />
				<Button Style="{StaticResource Style.Button}"
						Padding="8,6"
						ToolTip="{DynamicResource S.Info.Tooltip}"
						Click="OnInfoButtonClick"
						HorizontalAlignment="Right"
						DockPanel.Dock="Right">
					<TextBlock Text="ⓘ" FontSize="15" />
				</Button>
			</DockPanel>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UiZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="−"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
							Click="OnUiZoomOutClick" />
					<TextBlock x:Name="UiZoomText"
								   Width="40"
								   TextAlignment="Center"
								   Foreground="{StaticResource Brush.TextDim}"
								   FontSize="11"
								   VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="UiZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="+"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.InTooltip}"
							Click="OnUiZoomInClick" />
					<Button x:Name="ExportPngButton"
							Style="{StaticResource Style.Button}"
							Padding="8,2"
							Margin="8,0,0,0"
							ToolTip="{DynamicResource S.Editor.ExportPng}"
							Click="OnExportPngClick">
						<Rectangle Width="14" Height="14"
								   Fill="{StaticResource Brush.TextDim}"
								   RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/DownloadIcon32.png" Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</Button>
				</StackPanel>

				<TextBlock x:Name="CoordsText" Grid.Column="1"
							 Foreground="{StaticResource Brush.TextDim}"
							 VerticalAlignment="Center"
							 Margin="12,0,0,0" />

				<Button Grid.Column="3"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Editor.Cancel}"
						Margin="0,0,8,0" MinWidth="90"
						IsCancel="True" />
				<Button Grid.Column="4"
						Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Editor.Save}"
						MinWidth="90"
						Click="OnSaveClick" />
			</Grid>
		</Border>

		<DockPanel Margin="16">
		<TextBlock DockPanel.Dock="Top"
					 Text="{DynamicResource S.Hotspot.Hint}"
					 Foreground="{StaticResource Brush.TextDim}"
					 Margin="0,0,0,12" />

		<ScrollViewer HorizontalScrollBarVisibility="Auto"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Border Background="{StaticResource Brush.Bg}"
						BorderBrush="{DynamicResource Brush.Accent}"
						BorderThickness="3"
						VerticalAlignment="Center">
				<Canvas x:Name="PreviewCanvas"
						Background="Transparent"
						Cursor="Cross"
						MouseLeftButtonDown="OnCanvasMouseDown"
						MouseMove="OnCanvasMouseMove"
						MouseLeftButtonUp="OnCanvasMouseUp">
					<Image x:Name="PreviewImage" SnapsToDevicePixels="True" />
					<Ellipse x:Name="MarkerGlow"
							 Width="20" Height="20"
							 Fill="{StaticResource Brush.Accent}"
							 Opacity="0.3"
							 IsHitTestVisible="False" />
					<Ellipse x:Name="Marker"
							 Width="12" Height="12"
							 Fill="{StaticResource Brush.Accent}"
							 Stroke="White"
							 StrokeThickness="2"
							 IsHitTestVisible="False" />
				</Canvas>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
				<TextBlock Text="{DynamicResource S.Hotspot.Presets}"
							 Foreground="{StaticResource Brush.TextDim}"
							 FontSize="11"
							 HorizontalAlignment="Center"
							 Margin="0,0,0,6" />
				<UniformGrid x:Name="PresetGrid" Rows="3" Columns="3" Width="114" Height="114">
					<Button Tag="0,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,0" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="-45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="180" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/CenterIcon26.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="1,0.5" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
						</Rectangle>
					</Button>
					<Button Tag="0,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="135" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="0.5,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
					<Button Tag="1,1" Style="{StaticResource Style.Button}" Margin="2" Padding="0" Click="OnPresetPositionClick">
						<Rectangle Width="20" Height="20" Fill="{DynamicResource Brush.Text}" RenderTransformOrigin="0.5,0.5">
							<Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Resources/ArrowIcon48.png" Stretch="Uniform" /></Rectangle.OpacityMask>
							<Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
						</Rectangle>
					</Button>
				</UniformGrid>
			</StackPanel>
			</StackPanel>
		</ScrollViewer>
		</DockPanel>
	</DockPanel>
</Window>
