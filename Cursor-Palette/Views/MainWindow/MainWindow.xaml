<Window x:Class="CursorPalette.Views.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:CursorPalette"
		xmlns:services="clr-namespace:CursorPalette.Services"
		Title="{DynamicResource S.AppTitle}"
		Icon="pack://application:,,,/app.ico"
		Width="860" Height="640" MinWidth="720" MinHeight="440"
		Style="{StaticResource Style.Window}"
		AllowDrop="True"
		Drop="OnWindowDrop"
		DragOver="OnWindowDragOver"
		DragEnter="OnWindowDragEnter"
		DragLeave="OnWindowDragLeave">

	<Window.Resources>
		<Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="SpinnerRotate"
							  Storyboard.TargetProperty="Angle"
							  From="0" To="360" Duration="0:0:0.8" />
		</Storyboard>
		<Storyboard x:Key="UpdateSpinnerStoryboard" RepeatBehavior="Forever">
			<DoubleAnimation Storyboard.TargetName="UpdateSpinnerRotate"
							  Storyboard.TargetProperty="Angle"
							  From="0" To="360" Duration="0:0:0.8" />
		</Storyboard>
	</Window.Resources>

	<Grid x:Name="RootGrid">

	<DockPanel x:Name="RootPanel">
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Path Width="18" Height="18"
						  Stretch="Uniform"
						  Fill="{StaticResource Brush.Accent}"
						  Margin="0,0,8,0"
						  Data="M 0,0 L 0,16 L 4.5,12 L 7,18 L 9,17 L 6.5,11 L 12,11 Z" />
					<TextBlock Text="Cursor"
						   FontSize="16" FontWeight="SemiBold"
						   VerticalAlignment="Center" />
					<TextBlock Text="Palette"
						   FontSize="16" FontWeight="SemiBold"
						   Foreground="{StaticResource Brush.Accent}"
						   VerticalAlignment="Center"
						   Margin="2,0,0,0" />
				</StackPanel>

				<Button x:Name="LanguageButton" Grid.Column="3"
						Style="{StaticResource Style.Button}"
						Padding="8,6"
						Margin="0,0,8,0"
						ToolTip="{DynamicResource S.Language.Tooltip}"
						Click="OnLanguageButtonClick">
					<TextBlock x:Name="LanguageButtonText" FontSize="12" FontWeight="SemiBold" />
				</Button>

				<Button x:Name="ThemeToggleButton" Grid.Column="2"
						Style="{StaticResource Style.Button}"
						Padding="8,6"
						Margin="0,0,8,0"
						ToolTip="{DynamicResource S.Theme.ToggleTooltip}"
						Click="OnThemeToggleClick">
					<TextBlock x:Name="ThemeToggleIcon" FontSize="15" />
				</Button>

				<Button Grid.Column="4"
						Style="{StaticResource Style.Button}"
						Padding="8,6"
						ToolTip="{DynamicResource S.Info.Tooltip}"
						Click="OnInfoButtonClick">
					<TextBlock Text="ⓘ" FontSize="15" />
				</Button>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="240" />
					<ColumnDefinition Width="*" MinWidth="360" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Style="{StaticResource Style.GroupBorder}" Margin="0,0,12,0">
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Text="{DynamicResource S.GallerySize}"
									 Foreground="{StaticResource Brush.TextDim}"
									 VerticalAlignment="Center" />
						<Slider x:Name="CellScaleSlider" Grid.Column="1"
								Style="{StaticResource Style.Slider}"
								MinWidth="60" Margin="8,0"
								Minimum="{x:Static services:AppState.GalleryCellScaleMin}"
								Maximum="{x:Static services:AppState.GalleryCellScaleMax}"
								TickFrequency="0.1" IsSnapToTickEnabled="True"
								VerticalAlignment="Center"
								ValueChanged="OnCellScaleSliderValueChanged" />
						<TextBlock x:Name="CellScaleValueText" Grid.Column="2"
									 Width="46"
									 Foreground="{StaticResource Brush.TextDim}"
									 VerticalAlignment="Center" />
					</Grid>
				</Border>

				<Border Grid.Column="1" Style="{StaticResource Style.GroupBorder}" Margin="0,0,16,0">
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Text="{DynamicResource S.CursorSize}"
									 Foreground="{StaticResource Brush.TextDim}"
									 VerticalAlignment="Center" />
						<Slider x:Name="SizeSlider" Grid.Column="1"
								Style="{StaticResource Style.Slider}"
								MinWidth="90" Margin="8,0"
								Minimum="1" Maximum="15"
								TickFrequency="1" IsSnapToTickEnabled="True"
								VerticalAlignment="Center"
								ValueChanged="OnSizeSliderValueChanged" />
						<TextBlock x:Name="SizeValueText" Grid.Column="2"
									 Width="46"
									 Foreground="{StaticResource Brush.TextDim}"
									 VerticalAlignment="Center" />
						<Button x:Name="ApplySizeButton" Grid.Column="3"
								Style="{StaticResource Style.Button}"
								Content="{DynamicResource S.ApplySize}"
								ToolTip="{DynamicResource S.ApplySize.Tooltip}"
								Margin="8,0,0,0"
								Click="OnApplySizeButtonClick" />
					</Grid>
				</Border>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UndoButton"
							Style="{StaticResource Style.Button}"
							Content="{DynamicResource S.Undo}"
							ToolTip="{DynamicResource S.Undo.Tooltip}"
							Click="OnUndoButtonClick" />
				</StackPanel>
			</Grid>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,4">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="UiZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="−"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.OutTooltip}"
							Click="OnUiZoomOutClick" />
					<TextBlock x:Name="UiZoomText"
								 Width="40"
								 TextAlignment="Center"
								 Foreground="{StaticResource Brush.TextDim}"
								 FontSize="11"
								 VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="UiZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="+"
							Padding="8,2"
							ToolTip="{DynamicResource S.UiZoom.InTooltip}"
							Click="OnUiZoomInClick" />

					<Button x:Name="OpenFolderToggle"
							Style="{StaticResource Style.Button}"
							Padding="8,6"
							Margin="16,0,4,0"
							ToolTip="{DynamicResource S.OpenFolderAfterDownload.Tooltip}"
							Click="OnOpenFolderToggleClick">
						<Rectangle x:Name="OpenFolderIcon" Width="16" Height="16"
								   SnapsToDevicePixels="True"
								   Fill="{StaticResource Brush.Accent}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/OpenFolderIcon32.png"
											Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</Button>

				<Button x:Name="ExportButton"
							Style="{StaticResource Style.Button}"
							Padding="8,6"
							Margin="16,0,4,0"
							ToolTip="{DynamicResource S.Export.Tooltip}"
							Click="OnExportButtonClick">
						<Rectangle Width="16" Height="16"
								   SnapsToDevicePixels="True"
								   Fill="{StaticResource Brush.TextDim}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/DownloadIcon32.png"
											Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</Button>

					<StackPanel Orientation="Horizontal" Margin="0,0,8,0">
						<Button x:Name="ImportButton"
								Style="{StaticResource Style.Button}"
								Padding="8,6"
								ToolTip="{DynamicResource S.Import.Tooltip}"
								Click="OnImportButtonClick">
							<Rectangle Width="16" Height="16"
									   SnapsToDevicePixels="True"
									   Fill="{StaticResource Brush.TextDim}">
								<Rectangle.OpacityMask>
									<ImageBrush ImageSource="pack://application:,,,/Resources/ImportIcon26.png"
												Stretch="Uniform" />
								</Rectangle.OpacityMask>
							</Rectangle>
						</Button>
					</StackPanel>


					<Ellipse x:Name="UpdateSpinner"
							 Width="12" Height="12"
							 Stroke="{StaticResource Brush.Accent}"
							 StrokeThickness="2"
							 StrokeStartLineCap="Round"
							 StrokeEndLineCap="Round"
							 StrokeDashArray="14,5"
							 RenderTransformOrigin="0.5,0.5"
							 VerticalAlignment="Center"
							 Margin="16,0,0,0">
						<Ellipse.RenderTransform>
							<RotateTransform x:Name="UpdateSpinnerRotate" Angle="0" />
						</Ellipse.RenderTransform>
					</Ellipse>

					<TextBlock x:Name="UpdateCheckingLabel"
							   Text="{DynamicResource S.Update.Checking}"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Margin="6,0,0,0" />

					<StackPanel x:Name="UpdateIndicator"
								Orientation="Horizontal"
								VerticalAlignment="Center"
								Margin="16,0,0,0"
								Visibility="Collapsed">
						<Button Style="{StaticResource Style.AccentButton}"
								Content="{DynamicResource S.Update.Available}"
								FontSize="11"
								Padding="14,5"
								Cursor="Hand"
								ToolTip="{DynamicResource S.Update.Available.Tooltip}"
								Click="OnUpdateIndicatorClick" />
					</StackPanel>

					<TextBlock x:Name="UpToDateLabel"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Margin="16,0,0,0"
							   Cursor="Hand"
							   ToolTip="{DynamicResource S.Update.Recheck.Tooltip}"
							   MouseLeftButtonUp="OnUpToDateLabelClick"
							   Visibility="Collapsed">
						<Run Text="&#x2713; " />
						<Run Text="{DynamicResource S.Update.UpToDate}" />
					</TextBlock>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
					<TextBlock x:Name="FooterText"
								 Foreground="{StaticResource Brush.TextDim}"
								 FontSize="11"
								 VerticalAlignment="Center"
								 Cursor="Hand">
						<Hyperlink x:Name="FooterLink"
									  Foreground="{StaticResource Brush.TextDim}"
									  TextDecorations="None"
									  ToolTip="{DynamicResource S.About.LicenseHint}"
									  Click="OnFooterClick">
							<Run x:Name="FooterRun" />
						</Hyperlink>
					</TextBlock>
					<Border Margin="8,0,0,0"
							Cursor="Hand"
							ToolTip="{x:Static local:AppInfo.GitHubUrl}"
							MouseLeftButtonUp="OnGitHubIconClick">
						<Rectangle Width="20" Height="20"
								   SnapsToDevicePixels="True"
								   Fill="{StaticResource Brush.TextDim}">
							<Rectangle.OpacityMask>
								<ImageBrush ImageSource="pack://application:,,,/Resources/GitHub48.png"
											Stretch="Uniform" />
							</Rectangle.OpacityMask>
						</Rectangle>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<Border x:Name="GroupToolbar" DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10"
				Visibility="Collapsed">
			<Grid VerticalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="GroupSelectionCountText" Grid.Column="0"
						   Foreground="{StaticResource Brush.TextDim}"
						   VerticalAlignment="Center" Margin="0,0,16,0" />

				<WrapPanel x:Name="GroupColorSwatches" Grid.Column="1"
						   Orientation="Horizontal"
						   VerticalAlignment="Center"
						   Margin="0,0,16,0" />

				<TextBox x:Name="GroupNameBox" Grid.Column="2"
						 Style="{StaticResource Style.TextBox}"
						 VerticalAlignment="Center"
						 MaxLength="60"
						 Margin="0,0,12,0" />

				<Button x:Name="GroupCancelButton" Grid.Column="3"
						Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Group.Cancel}"
						Margin="0,0,8,0" MinWidth="90"
						Click="OnGroupCancelClick" />

				<Button x:Name="GroupCreateButton" Grid.Column="4"
						Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Group.Create}"
						MinWidth="110"
						Click="OnGroupCreateClick" />
			</Grid>
		</Border>

		<ScrollViewer x:Name="GalleryScroll" Background="Transparent" VerticalScrollBarVisibility="Auto" Padding="12" MouseRightButtonUp="OnGalleryRightClick">
			<StackPanel Background="Transparent">
				<TextBlock x:Name="EmptyHint"
							 Text="{DynamicResource S.EmptyGallery}"
							 Foreground="{StaticResource Brush.TextDim}"
							 TextWrapping="Wrap"
							 Margin="8,16"
							 Visibility="Collapsed" />

				<ItemsControl x:Name="Gallery" Background="Transparent">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

	</DockPanel>

	<Rectangle x:Name="WindowDropIndicator"
			   Stroke="{StaticResource Brush.Accent}"
			   StrokeThickness="4"
			   StrokeDashArray="6 3"
			   Margin="4"
			   IsHitTestVisible="False"
			   Visibility="Collapsed"
			   Panel.ZIndex="900" />

	<Rectangle x:Name="GroupAttachIndicator"
			   StrokeThickness="1.5"
			   StrokeDashArray="4 3"
			   RadiusX="14" RadiusY="14"
			   IsHitTestVisible="False"
			   Visibility="Collapsed"
			   Panel.ZIndex="955"
			   HorizontalAlignment="Left"
			   VerticalAlignment="Top">
		<Rectangle.RenderTransform>
			<TranslateTransform x:Name="GroupAttachIndicatorTransform" />
		</Rectangle.RenderTransform>
	</Rectangle>

	<Rectangle x:Name="ReorderInsertionLine"
			   Fill="{StaticResource Brush.Accent}"
			   Width="4"
			   RadiusX="2" RadiusY="2"
			   IsHitTestVisible="False"
			   Visibility="Collapsed"
			   Panel.ZIndex="950"
			   HorizontalAlignment="Left"
			   VerticalAlignment="Top">
		<Rectangle.RenderTransform>
			<TranslateTransform x:Name="ReorderInsertionLineTransform" />
		</Rectangle.RenderTransform>
	</Rectangle>

	<Border x:Name="DragGhost"
			IsHitTestVisible="False"
			Visibility="Collapsed"
			Opacity="0.85"
			Panel.ZIndex="960"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			CornerRadius="10"
			BorderThickness="2"
			Background="{StaticResource Brush.Surface}"
			BorderBrush="{StaticResource Brush.Accent}">
		<Border.RenderTransform>
			<TranslateTransform x:Name="DragGhostTransform" />
		</Border.RenderTransform>
		<StackPanel VerticalAlignment="Center">
			<Image x:Name="DragGhostImage" SnapsToDevicePixels="True" />
			<TextBlock x:Name="DragGhostText"
					   TextTrimming="CharacterEllipsis"
					   TextAlignment="Center"
					   Margin="4,8,4,0" />
		</StackPanel>
	</Border>

	<Border x:Name="LoadingOverlay"
			Background="#B3000000"
			Visibility="Collapsed"
			IsHitTestVisible="False"
			Panel.ZIndex="1000">
		<Ellipse Width="48" Height="48"
				 Stroke="{StaticResource Brush.Accent}"
				 StrokeThickness="4"
				 StrokeStartLineCap="Round"
				 StrokeEndLineCap="Round"
				 StrokeDashArray="28,9"
				 RenderTransformOrigin="0.5,0.5">
			<Ellipse.RenderTransform>
				<RotateTransform x:Name="SpinnerRotate" Angle="0" />
			</Ellipse.RenderTransform>
		</Ellipse>
	</Border>

	</Grid>
</Window>
