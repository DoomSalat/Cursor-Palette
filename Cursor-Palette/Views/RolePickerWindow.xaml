<Window x:Class="CursorPalette.Views.RolePickerWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.RolePicker.Title}"
		Width="640" Height="480" MinWidth="420" MinHeight="320"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">

	<DockPanel>
		<DockPanel.LayoutTransform>
			<ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
		</DockPanel.LayoutTransform>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,8">
			<Button Style="{StaticResource Style.Button}"
					Padding="8,6"
					ToolTip="{DynamicResource S.Info.Tooltip}"
					Click="OnInfoButtonClick"
					HorizontalAlignment="Right">
				<TextBlock Text="ⓘ" FontSize="15" />
			</Button>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10">
			<Button Style="{StaticResource Style.Button}"
					Content="{DynamicResource S.Editor.Cancel}"
					HorizontalAlignment="Right"
					MinWidth="90"
					IsCancel="True" />
		</Border>

		<DockPanel Margin="16">
			<TextBlock DockPanel.Dock="Top" x:Name="SourceNameText"
						 FontWeight="SemiBold"
						 Margin="0,0,0,4" />

			<CheckBox DockPanel.Dock="Top" x:Name="OnlyCurrentRoleCheck"
					  Style="{StaticResource Style.ToggleCheckBox}"
					  Content="{DynamicResource S.RolePicker.OnlyCurrentRole}"
					  IsChecked="True"
					  Margin="0,0,0,10"
					  Checked="OnOnlyCurrentRoleChanged"
					  Unchecked="OnOnlyCurrentRoleChanged" />

			<Grid>
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="Tiles">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
					</ItemsControl>
				</ScrollViewer>

				<TextBlock x:Name="EmptyHint"
							 Text="{DynamicResource S.RolePicker.RoleNotAssigned}"
							 Foreground="{StaticResource Brush.TextDim}"
							 TextAlignment="Center"
							 TextWrapping="Wrap"
							 HorizontalAlignment="Center"
							 VerticalAlignment="Center"
							 Visibility="Collapsed" />
			</Grid>
		</DockPanel>
	</DockPanel>
</Window>
