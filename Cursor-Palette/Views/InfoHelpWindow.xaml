<Window x:Class="CursorPalette.Views.InfoHelpWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Width="600" Height="600"
		MinWidth="380" MinHeight="300"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		ResizeMode="CanResize">

	<DockPanel>
		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10">
			<Button Style="{StaticResource Style.AccentButton}"
					Content="{DynamicResource S.Info.Close}"
					IsCancel="True"
					HorizontalAlignment="Right"
					MinWidth="90" />
		</Border>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<TextBlock Text="ⓘ"
							   FontSize="16"
							   Foreground="{StaticResource Brush.Accent}"
							   VerticalAlignment="Center"
							   Margin="0,0,8,0" />
					<TextBlock x:Name="TitleText"
							   FontSize="15" FontWeight="SemiBold"
							   VerticalAlignment="Center" />
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="TextZoomOutButton"
							Style="{StaticResource Style.Button}"
							Content="A−"
							Padding="8,2"
							ToolTip="{DynamicResource S.Info.ZoomOutTooltip}"
							Click="OnTextZoomOutClick" />
					<TextBlock x:Name="TextZoomText"
							   Width="40"
							   TextAlignment="Center"
							   Foreground="{StaticResource Brush.TextDim}"
							   FontSize="11"
							   VerticalAlignment="Center" Margin="6,0" />
					<Button x:Name="TextZoomInButton"
							Style="{StaticResource Style.Button}"
							Content="A+"
							Padding="8,2"
							ToolTip="{DynamicResource S.Info.ZoomInTooltip}"
							Click="OnTextZoomInClick" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  Padding="20,16">
			<StackPanel x:Name="BodyPanel" />
		</ScrollViewer>
	</DockPanel>
</Window>
