<Window x:Class="CursorPalette.Views.InfoHelpWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Width="520" Height="520"
		MinWidth="360" MinHeight="280"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		ResizeMode="CanResize">

	<DockPanel>
		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10">
			<Button Style="{StaticResource Style.AccentButton}"
					Content="{DynamicResource S.Info.Close}"
					IsCancel="True"
					HorizontalAlignment="Right"
					MinWidth="90" />
		</Border>

		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="ⓘ"
						   FontSize="16"
						   Foreground="{StaticResource Brush.Accent}"
						   VerticalAlignment="Center"
						   Margin="0,0,8,0" />
				<TextBlock x:Name="TitleText"
						   FontSize="15" FontWeight="SemiBold"
						   VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  Padding="20,16">
			<StackPanel x:Name="BodyPanel" />
		</ScrollViewer>
	</DockPanel>
</Window>
