<Window x:Class="CursorPalette.Views.UpdateWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="{DynamicResource S.Update.WindowTitle}"
		Width="420" Height="240"
		MinWidth="360" MinHeight="200"
		Style="{StaticResource Style.Window}"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		ResizeMode="NoResize">

	<DockPanel>
		<Border DockPanel.Dock="Top"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,0,0,1"
				Padding="16,10">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="⬇"
						   FontSize="16"
						   Foreground="{StaticResource Brush.Accent}"
						   VerticalAlignment="Center"
						   Margin="0,0,8,0" />
				<TextBlock x:Name="HeaderText"
						   FontSize="15" FontWeight="SemiBold"
						   VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<Border DockPanel.Dock="Bottom"
				Background="{StaticResource Brush.Surface}"
				BorderBrush="{StaticResource Brush.Border}"
				BorderThickness="0,1,0,0"
				Padding="16,10">
			<Button Style="{StaticResource Style.Button}"
					Content="{DynamicResource S.Update.Cancel}"
					IsCancel="True"
					HorizontalAlignment="Right"
					MinWidth="90"
					Click="OnCancelClick" />
		</Border>

		<StackPanel VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Margin="20">
			<TextBlock x:Name="VersionInfoText"
					   FontSize="13"
					   HorizontalAlignment="Center"
					   Margin="0,0,0,20" />

			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Center">
				<Button Style="{StaticResource Style.AccentButton}"
						Content="{DynamicResource S.Update.AutoUpdate}"
						Margin="0,0,10,0"
						MinWidth="130"
						Padding="16,10"
						Click="OnAutoUpdateClick" />
				<Button Style="{StaticResource Style.Button}"
						Content="{DynamicResource S.Update.ManualDownload}"
						MinWidth="130"
						Padding="16,10"
						Click="OnManualDownloadClick" />
			</StackPanel>

			<TextBlock x:Name="StatusText"
					   FontSize="11"
					   Foreground="{StaticResource Brush.TextDim}"
					   HorizontalAlignment="Center"
					   Margin="0,16,0,0"
					   Visibility="Collapsed" />
		</StackPanel>
	</DockPanel>
</Window>
